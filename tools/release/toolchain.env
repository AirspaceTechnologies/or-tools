# Single source of truth for the release toolchain versions.
# Consumed by:
#   - tools/release/*_airspace.Dockerfile (COPY'd into the image and sourced)
#   - .github/workflows/airspace_release.yml (loaded into $GITHUB_ENV)
# Mac dev machines should install matching versions (see AIRSPACE-README.md);
# the SWIG version in particular must match wherever the committed go/ tree
# is regenerated (see AGENTS.md "toolchain lockstep").
CMAKE_VERSION=3.31.2
SWIG_VERSION=4.3.1
GO_VERSION=1.26.5
PROTOC_GEN_GO_VERSION=v1.36.10
